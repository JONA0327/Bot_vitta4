CEREBRO_URL=https://tudominio.com
CEREBRO_TOKEN=ext_tu_api_key_del_bot
CEREBRO_TENANT=mi-negocio

# CEREBRO_TIMEOUT debe ser MENOR que el "timeout" del bot en CRM
# (Configuración → Bots Externos → timeout del bot).
# Ejemplo: si en CRM el bot tiene timeout=30, pon aquí 25.
CEREBRO_TIMEOUT=25

# Token de validación entrante (opcional pero recomendado).
# Debe coincidir con el "api_token" del tenant en CRM
# (Configuración → API Pública → Token Global).
# Si se deja vacío, el endpoint acepta cualquier request.
CRM_INCOMING_TOKEN=

BOT_FALLBACK_RESPONSE=En este momento no pude procesar tu mensaje. Intenta de nuevo en unos minutos.