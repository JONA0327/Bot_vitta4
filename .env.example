# ════════════════════════════════════════════════════════════════════════
# vitta4_Bot_3.0 — configuración
# ════════════════════════════════════════════════════════════════════════
# Copia este archivo a ".env" y llena los valores reales. Nunca subas el
# ".env" real a git (ya está en .gitignore).

# ── Conexión al CRM ─────────────────────────────────────────────────────
# Base de la API pública del CRM, SIN el slug del tenant al final.
# Ej: si tu CRM está en https://midominio.com, esto es https://midominio.com/api/v1
CRM_BASE_URL=https://tu-crm.com/api/v1

# Slug del tenant/negocio dentro del CRM (Panel → URL al entrar al negocio,
# o Configuración → Documentación API te lo confirma).
CRM_TENANT_SLUG=mi-negocio

# API Token general del CRM (Configuración → Entorno → API Token general).
# Se usa para POST /bot-send y los endpoints de /entrenamiento.
CRM_API_TOKEN=

# API Key dedicada del Prompt Builder (Configuración → Prompt → API Key de
# consulta). Se usa SOLO para /memoria y /prompt/* — nunca la misma que
# CRM_API_TOKEN, para que una fuga no exponga catálogos + conversaciones.
CRM_PROMPT_API_KEY=

# ── Servidor del bot (donde el CRM reenvía los mensajes entrantes) ───────
BOT_HOST=0.0.0.0
BOT_PORT=8000

# Pega esta misma URL (http://tu-bot:8000/webhook o tu dominio público) en
# el CRM: Configuración → Entorno → Webhook del bot.
BOT_PUBLIC_WEBHOOK_URL=http://localhost:8000/webhook

# Secreto compartido opcional — si lo defines aquí, el bot exige la cabecera
# X-Bot-Secret con este mismo valor en cada llamada entrante. Déjalo vacío
# para desactivar la validación (no recomendado en producción).
BOT_WEBHOOK_SECRET=

# ── Prompts (.vit) ───────────────────────────────────────────────────────
# Rutas locales a los archivos exportados desde Configuración → Prompt.
VIT_REGLAS_PATH=./prompts/reglas.vit
VIT_FILTROS_PATH=./prompts/filtros.vit

# "true"  → relee los .vit del disco en cada mensaje (útil mientras ajustas
#           el prompt, sin reiniciar el bot).
# "false" → los carga una sola vez al arrancar (más rápido en producción).
VIT_RELOAD_ON_CHANGE=true

# ── Proveedor de IA ───────────────────────────────────────────────────────
# Cuál motor usa el bot para RESPONDER. Valores válidos: openai | gemini | deepseek | claude
AI_PROVIDER=openai

# Proveedor para el Prompt de Filtros (clasificación). Si lo dejas vacío,
# usa el mismo que AI_PROVIDER — puedes poner uno más barato/rápido aquí.
FILTER_AI_PROVIDER=

# Solo necesitas llenar las claves del/los proveedor(es) que vayas a usar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── Anti-ciclo (para que el bot no se repita en la misma conversación) ───
# Cuántos mensajes de historial trae de GET /memoria antes de responder.
MEMORIA_LIMIT=10

# Si el bot genera una respuesta muy parecida a su(s) última(s) N respuestas
# seguidas para el mismo contacto, se considera "en bucle": en vez de
# reenviar lo mismo, envía {PAUSAR} y deja el caso para un humano.
MAX_RESPUESTAS_REPETIDAS=2

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
