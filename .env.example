# Token de validación entrante (opcional pero recomendado).
# Debe coincidir con el "api_token" del tenant en CRM
# (Configuración → API Pública → Token Global).
# Si se deja vacío, el endpoint acepta cualquier request.
CRM_INCOMING_TOKEN=

# Mensaje de prueba que devuelve el bot (personalizable)
BOT_RESPUESTA_PRUEBA=¡Hola! Soy el Bot Vitta4. Tu mensaje llegó correctamente. 🤖

# ── Historial de conversación desde CRM ────────────────────────────────────
# URL base del CRM (sin slash final)
CRM_URL=https://vitta4.autodevsystems.com
# Slug del tenant configurado en el CRM
CRM_TENANT=vitta4
# Token API del tenant (Configuración → API Pública → Token Global)
CRM_API_TOKEN=
# Timeout en segundos para llamadas al CRM (default: 8)
CRM_TIMEOUT=8
# Segundos de espera antes de responder (debounce anti-spam).
# Si el usuario envía otro mensaje dentro de ese tiempo, se reinicia el contador.
# Usa 0 para deshabilitar.
BOT_DEBOUNCE_SECS=20

# ── OpenAI (filtro, visión, Whisper, intención) ─────────────────────────────
OPENAI_API_KEY=
# Timeout en segundos para llamadas a OpenAI (default: 10)
OPENAI_TIMEOUT=10